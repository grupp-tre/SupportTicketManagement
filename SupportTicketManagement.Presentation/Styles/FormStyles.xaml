<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="FormPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="20"/>
        <Setter Property="MaxWidth" Value="750"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="FormTextAreaStyle" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MinHeight" Value="105"/>
    </Style>
    <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="FormRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="18"/>
    </Style>
    <Style x:Key="FormActionsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
    </Style>
</ResourceDictionary>
