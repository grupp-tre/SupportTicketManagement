<Page
    x:Class="SupportTicketManagement.Presentation.Views.TicketRegistrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <Grid Padding="32">
        <StackPanel
            MaxWidth="650"
            HorizontalAlignment="Left"
            Spacing="8">

            <TextBlock
                Text="Ticket registration"
                FontSize="26"
                FontWeight="SemiBold" />

            <TextBlock
                Text="Register a new support ticket"
                Foreground="Gray" />

            <TextBlock
                Text="Title *"
                FontWeight="SemiBold"
                Margin="0,16,0,0" />

            <TextBox
                x:Name="TitleTextBox"
                PlaceholderText="A short title for the ticket" />

            <TextBlock
                Text="Description *"
                FontWeight="SemiBold"
                Margin="0,8,0,0" />

            <TextBox
                x:Name="DescriptionTextBox"
                PlaceholderText="Describe the problem..."
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="120" />

            <Grid
                ColumnSpacing="16"
                Margin="0,8,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Spacing="6">

                    <TextBlock
                        Text="Customer *"
                        FontWeight="SemiBold" />

                    <ComboBox
                        x:Name="CustomerComboBox"
                        PlaceholderText="Select a registered customer..."
                        HorizontalAlignment="Stretch" />

                </StackPanel>

                
                <StackPanel
                    Grid.Column="1"
                    Spacing="6">

                    <TextBlock
                        Text="Priority"
                        FontWeight="SemiBold" />

                    <ComboBox
                        x:Name="PriorityComboBox"
                        SelectedIndex="1"
                        HorizontalAlignment="Stretch">

                        <ComboBoxItem Content="Low" />
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="High" />

                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock
                Text="* Required."
                Foreground="Gray"
                FontSize="13"
                Margin="0,8,0,0" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Margin="0,16,0,0">

                <Button
                    x:Name="SaveTicketButton"
                    Content="Save ticket" />

                <Button
                    x:Name="CancelButton"
                    Content="Cancel" />

            </StackPanel>
        </StackPanel>
    </Grid>
</Page>