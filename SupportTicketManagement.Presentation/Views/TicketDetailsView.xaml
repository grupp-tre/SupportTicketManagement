<Page
    x:Class="SupportTicketManagement.Presentation.Views.TicketDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SupportTicketManagement.Presentation.Models"
>
    <ScrollViewer>
        <StackPanel Padding="34" Spacing="20">
            <Button Content="← Back to Tickets" Command="{x:Bind ViewModel.BackCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />
            <TextBlock Text="Ticket details" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Metadata, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                HorizontalAlignment="Left"
             />
            <TextBlock
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextWrapping="Wrap"
            />
            <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                <StackPanel Style="{StaticResource FormPanelStyle}">
                    <TextBox
                        Header="Title *"
                        Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    />
                    <TextBox
                        Header="Description *"
                        Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormTextAreaStyle}"
                    />

                    <Grid Style="{StaticResource FormRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Header="Assignee"
                            ItemsSource="{x:Bind ViewModel.Assignees}"
                            DisplayMemberPath="Name"
                            SelectedItem="{x:Bind ViewModel.SelectedAssignee, Mode=TwoWay}"
                            Style="{StaticResource FormComboBoxStyle}"
                        />
                        <ComboBox
                            Grid.Column="1"
                            Header="Priority"
                            ItemsSource="{x:Bind ViewModel.Priorities}"
                            SelectedItem="{x:Bind ViewModel.Priority, Mode=TwoWay}"
                            Style="{StaticResource FormComboBoxStyle}"
                        />
                        <ComboBox
                            Grid.Column="2"
                            Header="Status"
                            ItemsSource="{x:Bind ViewModel.StatusOptions}"
                            SelectedIndex="{x:Bind ViewModel.StatusIndex, Mode=TwoWay}"
                            Style="{StaticResource FormComboBoxStyle}"
                        />
                    </Grid>

                    <StackPanel Style="{StaticResource FormActionsStyle}">
                        <Button
                            Content="Save changes"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                        />
                        <Button
                            Content="Cancel"
                            Command="{x:Bind ViewModel.BackCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                        />
                    </StackPanel>

                    <TextBlock Text="Comments" Style="{StaticResource SectionTitleStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Comments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TicketCommentRow">
                                <Border
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Padding="14"
                                    Margin="0,0,0,10"
                                >

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind Date}" Style="{StaticResource MutedTextStyle}" />
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                    </StackPanel>

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox
                        Header="New comment *"
                        PlaceholderText="Describe what has been done…"
                        Text="{x:Bind ViewModel.NewComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource FormTextAreaStyle}"
                    />
                    <Button
                        Content="Add comment"
                        Command="{x:Bind ViewModel.AddCommentCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                    />
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
