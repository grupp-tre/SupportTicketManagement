<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SupportTicketManagement.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportTicketManagement.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Support Ticket Management">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="AppNavigation"
        PaneTitle="Support Ticket Management"
        ItemInvoked="AppNavigation_ItemInvoked">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="OverviewNavigationItem"
                Content="Overview"
                Tag="overview"
                Icon="Home" />
            <NavigationViewItem
                x:Name="CustomersNavigationItem"
                Content="Customers"
                Tag="customers"
                Icon="People" />
            <NavigationViewItem
                x:Name="TicketsNavigationItem"
                Content="Tickets"
                Tag="tickets"
                Icon="Document" />
        </NavigationView.MenuItems>

        <Border>
            <ContentControl
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.Navigation.CurrentPage, Mode=OneWay}" />
        </Border>
    </NavigationView>
</Window>
